# Copie ce fichier en `.env` (déjà dans .gitignore, jamais commité) pour du dev local.
# Sur Render : mets ces mêmes variables dans l'onglet Environment du service,
# jamais dans un fichier du repo.

# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
# ⚠️ HOST à confirmer : si tu t'es connecté uniquement via phpMyAdmin dans le
# navigateur, "localhost:3306" est vu depuis LE SERVEUR lui-même (phpMyAdmin
# tourne sur la même machine que MySQL) — ça ne dit rien sur l'accès distant.
# Depuis Render, il faut l'IP publique (109.238.12.189) et il faut que MySQL
# accepte les connexions distantes sur cette IP (pas juste 127.0.0.1).
DATABASE_URL=mysql+pymysql://ehoudb_user:CHANGE_ME@109.238.12.189:3306/ehou_db

FILMING_ADMIN_TOKEN=change-me-avant-prod

CORS_ALLOWED_ORIGINS=https://pelify.app
