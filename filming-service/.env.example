# Copie ce fichier en `.env` (déjà dans .gitignore, jamais commité) pour du dev local.
# Sur Render : mets ces mêmes variables dans l'onglet Environment du service,
# jamais dans un fichier du repo.

# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# — remplace DATABASE_NAME par le nom réel de la base vu dans phpMyAdmin.
# — remplace PORT par le port MySQL réel (souvent 3306, différent du port
#   phpMyAdmin qui est juste l'interface web, ex: 8443).
DATABASE_URL=mysql+pymysql://ehoudb_user:CHANGE_ME@109.238.12.189:3306/CHANGE_ME

FILMING_ADMIN_TOKEN=change-me-avant-prod

CORS_ALLOWED_ORIGINS=https://pelify.app
